# ─── LLM Configuration ────────────────────────────────────────────────────────
# Which provider to use: gemini | anthropic | openai | deepseek
LLM_PROVIDER=gemini

# ─── Gemini: choose ONE authentication mode ─────────────────────────────────────
#
# (A) Vertex AI + Application Default Credentials (recommended on GCP / Enterprise)
#     Use after: gcloud auth application-default login
#     Ensure IAM: roles/aiplatform.user (or org-approved equivalent).
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# (B) Google AI Studio API key (consumer Gemini API via google-generativeai)
#     Required when GOOGLE_GENAI_USE_VERTEXAI=false for chat + embeddings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# ─── Vector Memory / Phase 3 ──────────────────────────────────────────────────
# Point this at the same PostgreSQL instance NestJS uses.
# Leave empty to run without memory (Phase 1/2 behaviour).
DATABASE_URL=postgresql://user:password@localhost:5432/app

# Embedding model (used for both legacy API key and Vertex; name may differ by API surface)
# Examples: models/text-embedding-004 (legacy) / check Vertex model list for your region
EMBEDDING_MODEL=models/text-embedding-004

# ─── AI Requirements Queue (Redis Streams) ────────────────────────────────────
# The agent consumes jobs from NestJS and publishes results back through Redis.
REDIS_URL=redis://localhost:6379
AI_REQUIREMENTS_QUEUE_JOBS_STREAM=stream:ai-requirements:jobs
AI_REQUIREMENTS_QUEUE_JOBS_GROUP=ai-requirements-agent-workers
AI_REQUIREMENTS_QUEUE_JOBS_CONSUMER=agent-1
AI_REQUIREMENTS_QUEUE_RESULTS_STREAM=stream:ai-requirements:results
AI_REQUIREMENTS_QUEUE_BATCH_SIZE=10
AI_REQUIREMENTS_QUEUE_BLOCK_MS=5000
AI_REQUIREMENTS_QUEUE_MAX_RETRIES=5
AI_REQUIREMENTS_QUEUE_CLAIM_IDLE_MS=30000
AI_REQUIREMENTS_QUEUE_STREAM_MAXLEN=10000
AI_REQUIREMENTS_QUEUE_JOBS_DLQ_STREAM=stream:ai-requirements:jobs:dlq

# ─── Upload References From NestJS ────────────────────────────────────────────
# Local mode: mount/share the backend upload directory and set AI_UPLOAD_LOCAL_ROOT.
AI_UPLOAD_LOCAL_ROOT=
# S3 mode: agent downloads queued s3://bucket/key or bucket+key references.
AI_UPLOAD_S3_BUCKET=
AI_UPLOAD_S3_ENDPOINT_URL=
AI_UPLOAD_S3_REGION=us-east-1
AI_UPLOAD_S3_ACCESS_KEY_ID=
AI_UPLOAD_S3_SECRET_ACCESS_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (NestJS base URL)
ALLOWED_ORIGINS=http://localhost:3000

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8100
