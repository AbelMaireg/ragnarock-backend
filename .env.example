NODE_ENV=development

# App
PORT=8000
ADMIN_PORT=8001
MCP_PORT=8002
DOCS_PATH_MAIN=/docs
DOCS_PATH_ADMIN=/docs
DOCS_OPENAPI_PATH_MAIN=/docs/openapi.json
DOCS_OPENAPI_PATH_ADMIN=/docs/openapi.json
DOCS_TITLE_MAIN=Main API
DOCS_DESCRIPTION_MAIN=Main service API documentation
DOCS_VERSION_MAIN=1.0.0
DOCS_TITLE_ADMIN=Admin API
DOCS_DESCRIPTION_ADMIN=Admin service API documentation
DOCS_VERSION_ADMIN=1.0.0

# Database (Postgres)
DB_HOST=postgres
DB_PORT=5432
DB_USER=user
DB_PASSWORD=secret
DB_NAME=app
DB_SSL=false
DATABASE_URL=postgresql://user:secret@postgres:5432/app?schema=public
POSTGRES_USER=user
POSTGRES_PASSWORD=secret
POSTGRES_DB=app

# Cache (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=60

# AI Requirements Queue (Redis Streams)
AI_REQUIREMENTS_QUEUE_JOBS_STREAM=stream:ai-requirements:jobs
AI_REQUIREMENTS_QUEUE_RESULTS_STREAM=stream:ai-requirements:results
AI_REQUIREMENTS_QUEUE_RESULTS_GROUP=ai-requirements-result-workers
AI_REQUIREMENTS_QUEUE_RESULTS_CONSUMER=backend-1
AI_REQUIREMENTS_QUEUE_BATCH_SIZE=10
AI_REQUIREMENTS_QUEUE_BLOCK_MS=5000
AI_REQUIREMENTS_QUEUE_MAX_RETRIES=5
AI_REQUIREMENTS_QUEUE_CLAIM_IDLE_MS=30000
AI_REQUIREMENTS_QUEUE_STREAM_MAXLEN=10000

# S3
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# File Storage
FILESYSTEM_DRIVER=local
LOCAL_STORAGE_ROOT=uploads

# Mail queue (async delivery via Redis Streams — uses REDIS_HOST/REDIS_PORT when REDIS_URL is unset)
# REDIS_URL=redis://localhost:6379

# Mail (Nodemailer → Mailpit SMTP on the Docker network; UI via nginx → http://mailpit.localhost)
MAIL_DRIVER=nodemailer
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Application
NODEMAILER_HOST=mailpit
NODEMAILER_PORT=1025
NODEMAILER_SECURE=false
# NODEMAILER_USER=
# NODEMAILER_PASSWORD=
# API on host (not in compose): set NODEMAILER_HOST=localhost in .env.local
# Mailpit UI (compose + nginx): http://mailpit.localhost
#
# Gmail via App Password (API on host; MAIL_FROM_EMAIL must match NODEMAILER_USER):
# MAIL_FROM_EMAIL=you@gmail.com
# NODEMAILER_HOST=smtp.gmail.com
# NODEMAILER_PORT=465
# NODEMAILER_SECURE=true
# NODEMAILER_USER=you@gmail.com
# NODEMAILER_PASSWORD=your-16-char-app-password

# Auth (Better Auth)
BETTER_AUTH_SECRET=922cc7accd45b239bdf0996857dd6050e500432954b34af24474b497660b3f0a
# Public browser URL of the Next.js app (invitation emails). Default matches local frontend.
AUTH_PUBLIC_APP_URL=http://localhost:3000
# OAuth redirect_uri base only — must be http://localhost:8000/... in Google/GitHub consoles. Use main.localhost for the API everywhere else (NEXT_PUBLIC_* , nginx).
BETTER_AUTH_URL=http://localhost:8000
BETTER_AUTH_BASE_PATH=/api/auth
SESSION_EXPIRES_IN_SECONDS=604800
SESSION_UPDATE_AGE_SECONDS=86400
AUTH_USE_SECURE_COOKIES=false
# Trusted origins (comma-separated) for CSRF/Origin checks. Include every frontend URL that calls the auth API.
AUTH_TRUSTED_ORIGINS=http://main.localhost,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,http://admin.localhost,http://app.localhost
# Parent domain for cross-subdomain cookies. "localhost" allows *.localhost to share cookies. Leave empty to disable.
AUTH_COOKIE_DOMAIN=localhost
# Issue SameSite=None; Secure cookies so they are sent on cross-site XHR. Browsers treat *.localhost as a secure context even over HTTP.
AUTH_CROSS_SITE_COOKIES=true
AUTH_APP_NAME=Application
AUTH_EMAIL_OTP_LENGTH=6
AUTH_EMAIL_OTP_EXPIRES_IN_SECONDS=300
AUTH_EMAIL_OTP_ALLOWED_ATTEMPTS=3
AUTH_EMAIL_OTP_RESEND_STRATEGY=rotate
AUTH_EMAIL_OTP_SEND_ON_SIGNUP=false
AUTH_EMAIL_OTP_DISABLE_SIGNUP=false
AUTH_EMAIL_OTP_STORE=encrypted
AUTH_EMAIL_OTP_OVERRIDE_DEFAULT_EMAIL_VERIFICATION=false
AUTH_EMAIL_OTP_CHANGE_EMAIL_ENABLED=false
AUTH_EMAIL_OTP_CHANGE_EMAIL_VERIFY_CURRENT=false

# OAuth — Google & GitHub (optional). Omit or leave empty to disable a provider.
# Register redirect URIs on the API host (not the Next.js app):
#   Google: http://localhost:8000/api/auth/callback/google
#   GitHub: http://localhost:8000/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Typesense
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=your-typesense-api-key-here
TYPESENSE_DATA_DIR=/data
TYPESENSE_ENABLE_CORS=true

# Organization integrations — encrypt stored provider tokens (min 16 characters).
INTEGRATIONS_CREDENTIALS_SECRET=change-me-min-16-chars

# Linear sync (optional dev fallback PAT; production uses org IntegrationConnection).
LINEAR_API_URL=https://api.linear.app/graphql
LINEAR_API_KEY=
LINEAR_SYNC_ENABLED=false
LINEAR_SYNC_CRON=*/15 * * * *
LINEAR_SYNC_BATCH_SIZE=25

# FastAPI AI agent.
# If backend runs in Docker and agent runs on host, use host.docker.internal.
AI_AGENT_BASE_URL=http://host.docker.internal:8100
# Must match the agent's internal API key exactly.
AI_AGENT_INTERNAL_API_KEY=change-me
