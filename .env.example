NODE_ENV=development

# App
PORT=3000
ADMIN_PORT=3001

# Database (Postgres)
DB_HOST=postgres
DB_PORT=5432
DB_USER=user
DB_PASSWORD=secret
DB_NAME=app
DB_SSL=false
DATABASE_URL=postgresql://user:secret@postgres:5432/app?schema=public
POSTGRES_USER=user
POSTGRES_PASSWORD=secret
POSTGRES_DB=app

# Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=60

# S3
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# File Storage
FILESYSTEM_DRIVER=local
LOCAL_STORAGE_ROOT=uploads

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_BASE_PATH=/api/auth
SESSION_EXPIRES_IN_SECONDS=604800
SESSION_UPDATE_AGE_SECONDS=86400
AUTH_USE_SECURE_COOKIES=false
AUTH_APP_NAME=Makeup App
AUTH_EMAIL_OTP_LENGTH=6
AUTH_EMAIL_OTP_EXPIRES_IN_SECONDS=300
AUTH_EMAIL_OTP_ALLOWED_ATTEMPTS=3
AUTH_EMAIL_OTP_RESEND_STRATEGY=rotate
AUTH_EMAIL_OTP_SEND_ON_SIGNUP=false
AUTH_EMAIL_OTP_DISABLE_SIGNUP=false
AUTH_EMAIL_OTP_STORE=encrypted
AUTH_EMAIL_OTP_OVERRIDE_DEFAULT_EMAIL_VERIFICATION=false
AUTH_EMAIL_OTP_CHANGE_EMAIL_ENABLED=false
AUTH_EMAIL_OTP_CHANGE_EMAIL_VERIFY_CURRENT=false
