NODE_ENV=development

# App
PORT=3000
ADMIN_PORT=3001

# Database (Postgres)
DB_HOST=postgres
DB_PORT=5432
DB_USER=user
DB_PASSWORD=secret
DB_NAME=app
DB_SSL=false
DATABASE_URL=postgresql://user:secret@postgres:5432/app?schema=public
POSTGRES_USER=user
POSTGRES_PASSWORD=secret
POSTGRES_DB=app

# Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=60

# S3
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# File Storage
FILESYSTEM_DRIVER=local
LOCAL_STORAGE_ROOT=uploads
