{
    "name": "backend",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "packageManager": "bun@1.3.9",
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "oxfmt --write apps libs",
        "prisma:generate": "prisma generate",
        "prisma:migrate:dev": "prisma migrate dev",
        "start": "nest start main",
        "start:dev": "nest start main --watch",
        "start:debug": "nest start main --debug --watch",
        "start:prod": "node dist/apps/main/main",
        "start:admin": "nest start admin",
        "start:admin:dev": "nest start admin --watch",
        "start:admin:debug": "nest start admin --debug --watch",
        "lint": "oxlint --fix apps libs",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./apps/main/test/jest-e2e.json",
        "test:e2e:admin": "jest --config ./apps/admin/test/jest-e2e.json"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1020.0",
        "@aws-sdk/s3-request-presigner": "^3.1020.0",
        "@getbrevo/brevo": "^2.0.0",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.3",
        "@nestjs/core": "^11.0.1",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/platform-socket.io": "^11.1.19",
        "@nestjs/schedule": "^6.1.3",
        "@nestjs/swagger": "^11.2.6",
        "@nestjs/websockets": "^11.1.19",
        "@octokit/request-error": "^7.1.0",
        "@octokit/rest": "^22.0.1",
        "@prisma/adapter-pg": "^7.6.0",
        "@prisma/client": "^7.6.0",
        "@scalar/nestjs-api-reference": "^1.1.6",
        "better-auth": "^1.6.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "graphql": "^16.14.0",
        "graphql-request": "^7.4.0",
        "handlebars": "^4.7.8",
        "nodemailer": "^7.0.7",
        "pg": "^8.20.0",
        "redis": "^5.8.2",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "socket.io": "^4.8.3",
        "typesense": "^3.0.5",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@better-auth/cli": "^1.4.21",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@swc/cli": "^0.6.0",
        "@swc/core": "^1.10.7",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/multer": "^2.1.0",
        "@types/node": "^22.10.7",
        "@types/nodemailer": "^7.0.11",
        "@types/supertest": "^6.0.2",
        "jest": "^29.7.0",
        "oxfmt": "^0.43.0",
        "oxlint": "^1.58.0",
        "prisma": "^7.6.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "./coverage",
        "testEnvironment": "node",
        "roots": [
            "<rootDir>/apps/"
        ]
    }
}
