generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum ProjectStatus {
    active
    archived
    completed
}

enum ProjectMemberRole {
    owner
    admin
    member
    viewer
}

enum TaskStatus {
    backlog
    todo
    in_progress
    reviewing
    reviewed
    done
    cancelled
}

/// Lifecycle / phase of work (planning vs build vs test, etc.).
enum TaskPhase {
    discovery
    planning
    build
    test
    release
}

enum TaskPriority {
    low
    medium
    high
    urgent
}

enum DocumentationStatus {
    draft
    pending_review
    completed
    rejected
}

/// Industry-standard doc kinds (abbreviations as enum members).
enum IntegrationProviderKey {
    linear
    figma
    cursor_workspace
}

enum IntegrationConnectionStatus {
    active
    error
    disconnected
    pending
}

enum IntegrationAuthMode {
    pat
    oauth2
    api_key
}

enum DocumentationType {
    brd
    prd
    frd
    srs
    srd
    trd
    sad
    adr
    hld
    lld
    icd
    dbd
    api
    stp
    std
    rtm
    ug
    om
    wbs
    raci
    note
}

enum RequirementStatus {
    draft
    in_review
    approved
    implemented
}

enum AiChatMessageRole {
    user
    assistant
}

model User {
    id               String       @id
    name             String?
    email            String       @unique
    emailVerified    Boolean      @default(false)
    image            String?
    createdAt        DateTime     @default(now())
    updatedAt        DateTime     @updatedAt
    posts            Post[]
    sessions         Session[]
    accounts         Account[]
    members          Member[]
    invitations      Invitation[] @relation("InvitationInviter")
    twoFactorEnabled Boolean?     @default(false)
    role             String?
    banned           Boolean?     @default(false)
    banReason        String?
    banExpires       DateTime?
    twofactors       TwoFactor[]
    teammembers      TeamMember[]
    projectMembers   ProjectMember[]
    assignedTasks    ProjectTask[]     @relation("ProjectTaskAssignee")
    createdDocs      ProjectDocumentation[] @relation("ProjectDocumentationAuthor")
    createdRequirements ProjectRequirement[] @relation("ProjectRequirementAuthor")
    projectActivities ProjectActivity[] @relation("ProjectActivityActor")
    integrationConnectionsCreated IntegrationConnection[] @relation("IntegrationConnectionCreator")
    skillsAuthored                    Skill[]                 @relation("SkillAuthor")
    createdAiChatSessions          ProjectAiChatSession[]    @relation("ProjectAiChatSessionAuthor")
    createdProjectSpecifications   ProjectSpecification[]    @relation("ProjectSpecificationAuthor")

    @@map("user")
}

model Post {
    id        Int     @id @default(autoincrement())
    title     String
    content   String?
    published Boolean @default(false)
    author    User    @relation(fields: [authorId], references: [id])
    authorId  String
}

model Session {
    id                   String   @id
    expiresAt            DateTime
    token                String   @unique
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt
    ipAddress            String?
    userAgent            String?
    userId               String
    user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    activeOrganizationId String?
    activeTeamId         String?
    impersonatedBy       String?

    @@index([userId])
    @@map("session")
}

model Account {
    id                    String    @id
    accountId             String
    providerId            String
    userId                String
    accessToken           String?
    refreshToken          String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    idToken               String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([providerId, accountId])
    @@index([userId])
    @@map("account")
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
    @@map("verification")
}

model Organization {
    id          String       @id
    name        String
    slug        String       @unique
    logo        String?
    metadata    String?
    createdAt   DateTime     @default(now())
    members     Member[]
    invitations Invitation[]
    teams                   Team[]
    projects                Project[]
    integrationConnections IntegrationConnection[]

    @@map("organization")
}

model Member {
    id             String       @id
    organizationId String
    userId         String
    role           String
    createdAt      DateTime     @default(now())
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    teams          Team[]       @relation("TeamMembers")

    @@unique([organizationId, userId])
    @@index([organizationId])
    @@index([userId])
    @@map("member")
}

model Invitation {
    id             String       @id
    organizationId String
    email          String
    role           String?
    status         String
    expiresAt      DateTime
    inviterId      String
    teamId         String?
    createdAt      DateTime     @default(now())
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

    @@index([organizationId])
    @@index([email])
    @@map("invitation")
}

model Team {
    id             String       @id
    organizationId String
    name           String
    createdAt      DateTime     @default(now())
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    members        Member[]     @relation("TeamMembers")
    updatedAt      DateTime?    @updatedAt
    teammembers    TeamMember[]

    @@index([organizationId])
    @@map("team")
}

model TwoFactor {
    id              String   @id
    userId          String   @unique
    secret          String?
    backupCodes     String?
    totpEnabled     Boolean  @default(false)
    emailOTPEnabled Boolean  @default(false)
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
    user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([secret])
    @@index([userId])
    @@map("twoFactor")
}

model TeamMember {
    id        String    @id
    teamId    String
    team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
    userId    String
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt DateTime?

    @@index([teamId])
    @@index([userId])
    @@map("teamMember")
}

model Project {
    id             String                 @id @default(cuid())
    organizationId String
    name           String
    description    String?
    status         ProjectStatus          @default(active)
    // Single shared draft SRS for the project. Every AI chat session reads and
    // writes this one draft so a new chat always continues from prior progress.
    draftSrs         Json?
    draftSrsProgress Int                  @default(0)
    createdAt      DateTime               @default(now())
    updatedAt      DateTime               @updatedAt
    organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    members        ProjectMember[]
    tasks          ProjectTask[]
    documentations ProjectDocumentation[]
    requirements   ProjectRequirement[]
    activities              ProjectActivity[]
    skills                  Skill[]
    aiChatSessions          ProjectAiChatSession[]
    projectSpecifications     ProjectSpecification[]

    @@index([organizationId])
    @@index([status])
    @@map("project")
}

model ProjectMember {
    id        String            @id @default(cuid())
    projectId String
    userId    String
    role      ProjectMemberRole @default(member)
    createdAt DateTime          @default(now())
    updatedAt DateTime          @updatedAt
    project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
    user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([projectId, userId])
    @@index([projectId])
    @@index([userId])
    @@map("projectMember")
}

model ProjectTask {
    id          String       @id @default(cuid())
    projectId   String
    title       String
    description String?
    status      TaskStatus   @default(todo)
    priority    TaskPriority @default(medium)
    assigneeId  String?
    phase       TaskPhase?
    startDate   DateTime?
    dueDate     DateTime?
    sortOrder   Int          @default(0)
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
    project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
    assignee    User?        @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

    @@index([projectId])
    @@index([assigneeId])
    @@index([status])
    @@index([projectId, status, sortOrder])
    @@map("projectTask")
}

model ProjectDocumentation {
    id         String               @id @default(cuid())
    projectId  String
    title      String
    type       DocumentationType    @default(note)
    status     DocumentationStatus  @default(draft)
    content    String
    version    Int                  @default(1)
    createdBy  String
    createdAt  DateTime             @default(now())
    updatedAt  DateTime             @updatedAt
    project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
    author     User                 @relation("ProjectDocumentationAuthor", fields: [createdBy], references: [id], onDelete: Restrict)

    @@index([projectId])
    @@index([projectId, status])
    @@index([projectId, type])
    @@index([createdBy])
    @@index([type])
    @@map("projectDocumentation")
}

model ProjectRequirement {
    id                 String            @id @default(cuid())
    projectId          String
    title              String
    description        String
    acceptanceCriteria String?
    status             RequirementStatus @default(draft)
    createdBy          String
    createdAt          DateTime          @default(now())
    updatedAt          DateTime          @updatedAt
    project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
    author             User              @relation("ProjectRequirementAuthor", fields: [createdBy], references: [id], onDelete: Restrict)

    @@index([projectId])
    @@index([createdBy])
    @@index([status])
    @@map("projectRequirement")
}

model ProjectAiChatSession {
    id             String                 @id @default(cuid())
    projectId      String
    createdBy      String
    title          String?
    partialSrs     Json?
    srsProgress    Int                    @default(0)
    createdAt      DateTime               @default(now())
    updatedAt      DateTime               @updatedAt
    project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
    author         User                   @relation("ProjectAiChatSessionAuthor", fields: [createdBy], references: [id], onDelete: Restrict)
    messages       ProjectAiChatMessage[]
    specifications ProjectSpecification[]

    @@index([projectId])
    @@index([createdBy])
    @@map("projectAiChatSession")
}

model ProjectAiChatMessage {
    id        String           @id @default(cuid())
    sessionId String
    role      AiChatMessageRole
    content   String           @db.Text
    payload   Json?
    createdAt DateTime         @default(now())
    session   ProjectAiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    @@index([sessionId, createdAt])
    @@map("projectAiChatMessage")
}

model ProjectSpecification {
    id             String               @id @default(cuid())
    projectId      String
    chatSessionId  String?
    createdBy      String
    title          String?
    payload        Json
    createdAt      DateTime             @default(now())
    updatedAt      DateTime             @updatedAt
    project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
    chatSession    ProjectAiChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
    author         User                 @relation("ProjectSpecificationAuthor", fields: [createdBy], references: [id], onDelete: Restrict)

    @@index([projectId])
    @@index([chatSessionId])
    @@index([createdBy])
    @@map("projectSpecification")
}

model ProjectActivity {
    id         String   @id @default(cuid())
    projectId  String
    actorId    String?
    action     String
    entityType String
    entityId   String?
    metadata   Json?
    createdAt  DateTime @default(now())
    project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    actor      User?    @relation("ProjectActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

    @@index([projectId, createdAt])
    @@index([actorId])
    @@map("projectActivity")
}

model IntegrationConnection {
    id                    String                      @id @default(cuid())
    organizationId      String
    provider            IntegrationProviderKey
    authMode            IntegrationAuthMode         @default(pat)
    status              IntegrationConnectionStatus @default(pending)
    encryptedCredentials String                     @db.Text
    lastError           String?                    @db.Text
    lastVerifiedAt      DateTime?
    createdByUserId     String
    createdAt           DateTime                   @default(now())
    updatedAt           DateTime                   @updatedAt
    organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    creator               User                      @relation("IntegrationConnectionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

    @@unique([organizationId, provider])
    @@index([organizationId])
    @@index([createdByUserId])
    @@map("integrationConnection")
}

model Skill {
    id           String   @id @default(cuid())
    projectId    String
    title        String
    slug         String
    summary      String?
    bodyMarkdown String   @db.Text
    createdBy    String
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
    project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    author       User     @relation("SkillAuthor", fields: [createdBy], references: [id], onDelete: Restrict)

    @@unique([projectId, slug])
    @@index([projectId])
    @@index([createdBy])
    @@map("skill")
}
